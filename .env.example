# =============================================================
# Chui Protocol 應用層環境變數範本
#
# 現行架構：後端＝Cloudflare Worker（apps/hub-worker）。
# 這份檔案是 `scripts/setup-worker.sh` 的輸入——複製成 .env 填好後
# 執行該腳本，機密值會上傳成 Cloudflare Secrets（不進 git、不留終端）。
# 事後單獨補某個值：
#   wrangler secret put <名稱> --config apps/hub-worker/wrangler.jsonc
#
# 非機密設定（SUI_NETWORK、USDC_UNITS_PER_TWD、CHUI_USDC_COIN_TYPE）
# 已寫死在 apps/hub-worker/wrangler.jsonc 的 vars，不在這裡。
# =============================================================

# ---- 部署（只給 setup-worker.sh 用，不會上傳到 Worker）----
# 取得方式：Cloudflare Dashboard → My Profile → API Tokens →
# Create Token（Workers 編輯權限）。demo 結束後記得撤銷。
CLOUDFLARE_API_TOKEN=

# ---- 鏈上合約 ----
# 取得方式：chui-contracts repo 執行 ./deploy.sh 後印出的 PACKAGE_ID
# （https://github.com/chuiprotocol/chui-contracts）。
# 未填時所有鏈上操作明確回 CHAIN_NOT_CONFIGURED，不偽造結果。
CHUI_PACKAGE_ID=

# ---- STT 語音辨識（多供應商遞補鏈；沒填 key 的供應商自動跳過）----
# 主力①：ElevenLabs Scribe v2。取得方式：https://elevenlabs.io
# → Profile → API Keys
ELEVENLABS_API_KEY=
# 主力②：OpenAI（gpt-4o-transcribe → whisper-1 自動遞補）。
# 取得方式：https://platform.openai.com/api-keys
STT_API_KEY=
# 進階（通常不用動）：
# STT_PROVIDERS=elevenlabs,openai,gmi,amd   # 覆寫遞補順序
# ELEVENLABS_STT_MODEL=scribe_v2            # 覆寫 ElevenLabs 模型
# STT_API_BASE= / STT_API_MODEL=            # 改用其他 OpenAI 相容端點
# 備援③④：GMI／AMD（開源 whisper 託管；三項齊全才啟用該家）
# GMI_API_KEY= / GMI_STT_BASE_URL= / GMI_STT_MODEL=
# AMD_API_KEY= / AMD_STT_BASE_URL= / AMD_STT_MODEL=

# ---- LLM 重述備援（只做聽不清時的重述，永遠碰不到金流決策）----
# 現行：GMI Cloud 免費 LLM。取得方式：https://console.gmicloud.ai
# → API Keys；Base URL 與模型名見其文件（OpenAI 相容端點）。
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ---- 匯率（選填；未填時用 wrangler.jsonc 的靜態匯率，healthz 誠實標 static）----
# 取得方式：https://docs.atlasoracle.io 註冊取得 API key 與 feed id。
ATLAS_ORACLE_API_KEY=
ATLAS_FEED_ID=

# ---- 前端（選填；Cloudflare Pages 建置環境變數，本機開發用 ?hub= 參數即可）----
# VITE_HUB_URL=https://hub.chuiprotocol.com   # 前端指向的 Hub 位址
# VITE_MERCHANT_ID=                           # 公版店面綁定的商家 id
