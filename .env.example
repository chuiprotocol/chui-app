# ============================================================
# Chui Protocol 應用層環境變數範本
# 複製成 .env 後逐項填入。每個變數都註明從哪裡取得。
# ============================================================

# ---- 網路（絕對不要改成 mainnet；程式內有防呆會直接拒絕啟動）----
# 取得方式：固定值。現階段一律 testnet。
SUI_NETWORK=testnet

# ---- 鏈上合約參數 ----
# 取得方式：chui-contracts repo 的 deployments/testnet.json。
# ⚠️ 該 repo 目前是空的（尚無 commit）；填入前所有鏈上操作會明確回
#    CHAIN_NOT_CONFIGURED，不會偽造結果。
CHUI_PACKAGE_ID=
# 合約若使用 shared registry 物件才需要（同樣來自 deployments/testnet.json）
CHUI_REGISTRY_ID=
# Move module／function 名稱（預設值是本 repo 的假定介面，需與合約 SPEC.md 核對）
CHUI_MODULE=mandate
CHUI_FN_CREATE=create
CHUI_FN_SETTLE=settle
CHUI_FN_REVOKE=revoke
# 合約 abort code 對映（JSON；需與合約錯誤常數核對）
CHUI_ABORT_CODES={"1":"E_OVER_PER_TX","2":"E_OVER_TOTAL","3":"E_REVOKED","4":"E_EXPIRED","5":"E_NOT_OPERATOR"}
# 金額換算：1 元 = 多少 MIST（整數）。預設 0.01 SUI／元（測試幣示意匯率）
AMOUNT_SCALE_MIST=10000000

# ---- Demo（Hub＋兩家店＋語音入口；見 DEMO.md）----
# Sui Testnet 的 USDC coin type（Circle 官方發行；固定值，通常不用改）
CHUI_USDC_COIN_TYPE=0xa1ec7fc00a6f40db9693ad1415d0c193ad3906494428cf252621037bd7117e29::usdc::USDC
# 換算：1 元（TWD）= 多少 USDC 最小單位（6 位小數）。預設 1 元 = 0.032 USDC
USDC_UNITS_PER_TWD=32000
# Hub 對外網址（手機 demo 用 cloudflared 隧道的 https 網址；本機開發保持預設）
HUB_PUBLIC_URL=http://localhost:8700
# Hub 商家 registry 路徑（預設 apps/hub/merchants.json）
# CHUI_REGISTRY_PATH=

# ---- 贊助者／操作者金鑰 ----
# 取得方式：`sui client new-address ed25519` 或 `sui keytool generate ed25519`，
# 匯出 suiprivkey 開頭的私鑰；再到 https://faucet.sui.io 領測試幣付 gas。
# 這把 key 同時是 gas 贊助者與結算操作者（信任假設見 README）。
SPONSOR_SECRET_KEY=

# ---- chain-service（Node sidecar，只綁 localhost）----
# 取得方式：自己產生一個隨機字串，例如 `openssl rand -hex 32`
CHAIN_SERVICE_TOKEN=
CHAIN_SERVICE_URL=http://127.0.0.1:8788
CHAIN_SERVICE_PORT=8788

# ---- API 伺服器 ----
# 取得方式：`openssl rand -hex 32`
CHUI_SESSION_SECRET=
CHUI_DATABASE_URL=sqlite:///./chui.db
# console 與 LIFF 的 origin（逗號分隔）
CORS_ORIGINS=http://localhost:5173,http://localhost:8790

# ---- STT（華語主路徑）----
# 取得方式：OpenAI 平台（https://platform.openai.com/api-keys）
# 或任何 OpenAI 相容供應商（Groq 等，改 STT_API_BASE 即可）。
# 不填 STT_API_KEY 時，語音輸入會退回本地 faster-whisper（需另外
# `pip install faster-whisper`），兩者皆無則明確報錯並引導文字輸入。
STT_PROVIDER=auto
STT_API_BASE=https://api.openai.com/v1
STT_API_KEY=
STT_API_MODEL=whisper-1

# ---- TTS ----
# 取得方式：https://elevenlabs.io → Profile → API Keys；
# voice ID 到 Voice Library 挑一個中文（台灣腔）voice，複製其 ID。
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_TIMEOUT_SECONDS=3.0
# edge-tts 備援 voice（免金鑰；固定值即可）
EDGE_TTS_VOICE=zh-TW-HsiaoChenNeural
TTS_CACHE_DIR=./tts_cache

# ---- zkLogin ----
# 取得方式：Google Cloud Console → APIs & Services → Credentials →
# OAuth 2.0 Client ID（Web application），redirect URI 填 console 網址。
ZKLOGIN_ALLOWED_AUDIENCES=
# 取得方式：`openssl rand -hex 32`。⚠️ 遺失＝所有 zkLogin 地址無法重建，務必備份。
ZKLOGIN_SALT_MASTER_SECRET=

# ---- console（Vite；放在 apps/console/.env）----
VITE_CHUI_API_URL=http://127.0.0.1:8787
VITE_GOOGLE_CLIENT_ID=
# 測試網開發用 prover（固定值）
VITE_ZKLOGIN_PROVER_URL=https://prover-dev.mystenlabs.com/v1

# ---- 參考店家（快樂豬 LINE bot；放在 apps/reference-merchant/.env）----
# 取得方式：LINE Developers Console（https://developers.line.biz）
# → 建立 Messaging API channel → Channel secret / Channel access token
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
# 取得方式：同 console → LIFF → 新增 LIFF app（endpoint 填 BASE_URL/liff/）
LIFF_ID=
# bot 對外網址（本機開發可用 ngrok / cloudflared 隧道）
BASE_URL=
# 取得方式：本 repo 的 Chui API 註冊回應（POST /v1/merchants 或後台註冊頁）
CHUI_API_KEY=
CHUI_API_URL=http://127.0.0.1:8787
# 取得方式：chui.registerWebhook() 的回應（只出現一次）
CHUI_WEBHOOK_SECRET=
CONSOLE_URL=http://localhost:5173
MERCHANT_PORT=8790
